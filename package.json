{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "test": "node --test \"tests/js/**/*.test.mjs\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.3",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.11"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@tiptap/extension-image": "^3.31.4",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "@tiptap/vue-3": "^3.31.4",
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vazirmatn": "^33.0.3",
        "vue": "^3.5.43",
        "vue-draggable-plus": "^0.6.1",
        "vue-i18n": "^11.4.12",
        "vue-router": "^5.3.1"
    }
}
